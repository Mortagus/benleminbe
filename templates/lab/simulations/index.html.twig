{% extends 'base.html.twig' %}

{% trans_default_domain 'lab' %}

{% block title %}{{ 'simulations.meta.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'simulations.meta.description'|trans }}{% endblock %}
{% block importmap %}{{ importmap(['app', 'page_lab']) }}{% endblock %}

{% block body %}
    <main class="lab-home lab-simulations">
        <header class="lab-home__hero">
            <p class="eyebrow">{{ 'simulations.hero.eyebrow'|trans }}</p>

            <h1>{{ 'simulations.hero.title'|trans }}</h1>

            <p class="lab-home__intro">
                {{ 'simulations.hero.intro'|trans|highlight_keywords }}
            </p>
        </header>

        <section class="content-section" aria-labelledby="simulations-list-title">
            <div class="card lab-panel">
                <div class="lab-panel__intro">
                    <h2 id="simulations-list-title">{{ 'simulations.index.title'|trans }}</h2>
                </div>

                <div class="lab-tool-grid">
                    {% for simulation in [
                        { key: 'boids2d', route: 'app_lab_simulations_boids' },
                        { key: 'boids3d', route: 'app_lab_simulations_boids3d' },
                    ] %}
                        <article class="lab-tool-card">
                            <p class="lab-tool-card__eyebrow">{{ ('simulations.index.' ~ simulation.key ~ '.label')|trans }}</p>

                            <h3>{{ ('simulations.index.' ~ simulation.key ~ '.title')|trans }}</h3>

                            <p>{{ ('simulations.index.' ~ simulation.key ~ '.description')|trans|highlight_keywords }}</p>

                            <ul class="lab-tool-card__meta" aria-label="{{ ('simulations.index.' ~ simulation.key ~ '.meta_label')|trans }}">
                                <li>{{ ('simulations.index.' ~ simulation.key ~ '.meta.1')|trans }}</li>
                                <li>{{ ('simulations.index.' ~ simulation.key ~ '.meta.2')|trans }}</li>
                                <li>{{ ('simulations.index.' ~ simulation.key ~ '.meta.3')|trans }}</li>
                            </ul>

                            <div class="lab-tool-card__actions">
                                <a href="{{ path(simulation.route) }}" class="button">
                                    {{ ('simulations.index.' ~ simulation.key ~ '.action')|trans }}
                                </a>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </section>
    </main>
{% endblock %}
