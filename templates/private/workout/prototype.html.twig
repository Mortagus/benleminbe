{% extends 'private/base.html.twig' %}

{% block title %}Workout — prototype de séance{% endblock %}

{% block importmap %}{{ importmap('private_workout_prototype') }}{% endblock %}

{% block body %}
    <section class="private-page workout-prototype" data-workout-prototype>
        <header class="private-page__header workout-prototype__header">
            <div class="private-page__title">
                <p class="private-eyebrow">Workout · prototype local</p>
                <h1>Séance habituelle</h1>
                <p class="private-page__lead">Maquette mobile basée sur ta séance réelle : les valeurs restent dans ce navigateur pour tester la saisie pendant l’entraînement.</p>
            </div>
            <div class="private-page__actions">
                <button class="private-link-button private-link-button--secondary" type="button" data-workout-reset>Réinitialiser l’essai</button>
            </div>
        </header>

        <p class="workout-prototype__status" aria-live="polite" data-workout-save-status>Essai local prêt.</p>

        <nav class="workout-prototype__steps" aria-label="Exercices de la séance">
            {% for exercise in exercises %}
                <button type="button" class="workout-prototype__step{% if loop.first %} is-current{% endif %}" data-workout-select="{{ exercise.id }}"{% if loop.first %} aria-current="step"{% endif %}>{{ loop.index }} <span>{{ exercise.name }}</span></button>
            {% endfor %}
        </nav>

        {% for exercise in exercises %}
            <article class="private-section-card workout-prototype__exercise" data-workout-exercise-id="{{ exercise.id }}"{% if not loop.first %} hidden{% endif %}>
                <header class="workout-prototype__exercise-header">
                    <div>
                        <p class="private-eyebrow">Exercice {{ loop.index }} sur {{ exercises|length }}</p>
                        <h2>{{ exercise.name }}</h2>
                        <p class="private-muted">Objectif : {{ exercise.goal }}</p>
                    </div>
                    <span class="workout-prototype__completion" data-workout-completion>0/{{ exercise.sets|length }}</span>
                </header>
                <p class="workout-prototype__set-position" aria-live="polite" data-workout-set-position>Série 1 sur {{ exercise.sets|length }}</p>
                <form class="workout-prototype__sets" data-workout-sets>
                    {% for set in exercise.sets %}
                        <fieldset class="workout-prototype__set" data-workout-set-id="{{ set.id }}">
                            <legend>{{ set.label }}</legend>
                            {% for field in set.fields %}
                                {% set inputId = 'workout-' ~ exercise.id ~ '-' ~ set.id ~ '-' ~ field.id %}
                                <div class="workout-prototype__field">
                                    <label for="{{ inputId }}">{{ field.label }}</label>
                                    <span class="workout-prototype__value-control" data-workout-value-control>
                                        <button type="button" data-workout-adjust="decrease" aria-label="Réduire {{ field.label }} de {{ field.step }}">−</button>
                                        <input id="{{ inputId }}" inputmode="{{ field.inputmode }}" type="number" min="0" step="{{ field.step }}" value="{{ field.value }}" data-workout-field="{{ field.id }}">
                                        <button type="button" data-workout-adjust="increase" aria-label="Augmenter {{ field.label }} de {{ field.step }}">+</button>
                                    </span>
                                </div>
                            {% endfor %}
                            <button type="button" class="private-link-button" data-workout-complete>Valider</button>
                        </fieldset>
                    {% endfor %}
                </form>
            </article>
        {% endfor %}

        <footer class="workout-prototype__navigation" data-workout-navigation hidden>
            <button class="private-link-button private-link-button--secondary" type="button" data-workout-previous>Exercice précédent</button>
            <button class="private-link-button" type="button" data-workout-next>Exercice suivant</button>
        </footer>
    </section>
{% endblock %}
